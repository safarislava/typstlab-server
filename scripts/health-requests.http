### Configuration Variables
@host = localhost:8080

### 1. Health Check
GET {{host}}/health

### 2. Register a New User
POST {{host}}/register
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "securepassword"
}

### 3. Login User (Obtain tokens and sets Cookie)
# @name login
POST {{host}}/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "securepassword"
}

> {%
    if (response.status === 200) {
        client.global.set("auth_token", response.body.token);
    }
%}

### 4. Create Project (Protected - uses access_token cookie)
POST {{host}}/projects
Content-Type: application/json

{
  "name": "My New Project"
}

### 5. Refresh Access Token (Uses HTTP-Only refresh_token cookie)
POST {{host}}/refresh

> {%
    if (response.status === 200) {
        client.global.set("auth_token", response.body.token);
    }
%}

### 6. Logout User (Clears refresh cookie and invalidates session)
POST {{host}}/logout

### 7. List Project Members
GET {{host}}/projects/{{project_id}}/members

### 8. Add Member to Project
POST {{host}}/projects/{{project_id}}/members
Content-Type: application/json

{
  "email": "collaborator@example.com"
}

### 9. Remove Member from Project
DELETE {{host}}/projects/{{project_id}}/members/{{user_id}}

### 10. Create Project Invite
POST {{host}}/projects/{{project_id}}/invites
Content-Type: application/json

{
  "expires_at": "2026-10-23T12:00:00Z"
}

### 11. List Project Invites
GET {{host}}/projects/{{project_id}}/invites

### 12. Revoke Project Invite
DELETE {{host}}/projects/{{project_id}}/invites/{{invite_id}}

### 13. Accept Project Invite
POST {{host}}/invites/{{invite_code}}/accept